# Public Supabase configuration used by the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Supabase configuration. Never expose this in NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only moderation email configuration.
# RESEND_FROM_EMAIL must use a verified Resend domain.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=FantaChat <notifiche@your-verified-domain.example>
SUPERADMIN_EMAIL=your-admin-email@example.com
